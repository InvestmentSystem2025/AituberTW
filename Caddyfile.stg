{
  # Optional: admin off
  # admin off
}

# AITuberKit (Next.js) - Staging (protected by Basic Auth)
stg.ai-interview.tw {
  @newebpayCallback path /api/newebpay/period/notify /api/newebpay/mpg/notify /api/newebpay/cau/notify /payment/result /payment/result/

  handle @newebpayCallback {
    reverse_proxy app:3000
  }

  handle {
    basicauth {
      {env.BASIC_AUTH_USER} {env.BASIC_AUTH_PASS_HASH}
    }
    reverse_proxy app:3000
  }

  log {
    output stdout
    level INFO
  }
}

# Self-hosted Supabase API gateway (Kong) - Staging (NO Basic Auth)
supabase-stg.ai-interview.tw {
  reverse_proxy supabase-kong:8000
}
