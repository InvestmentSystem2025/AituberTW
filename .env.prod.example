# Copy to `.env.prod` on the prod VM (do not commit).
#
# Run:
#   docker compose --env-file .env.prod -f docker-compose.gcp.yml up -d --build

# Which config files to mount
CADDYFILE_NAME=Caddyfile.prod
KONG_CONFIG_NAME=kong.gcp.prod.yml

# Domains / public URLs
FRONTEND_ORIGIN=https://ai-interview.tw
NEXT_PUBLIC_SUPABASE_URL=https://supabase.ai-interview.tw
AUTH_REDIRECT_URL=https://ai-interview.tw
SMTP_DEFAULT_REDIRECT_URL=https://ai-interview.tw
SITE_URL=https://supabase.ai-interview.tw

# Supabase / App secrets (fill with real values)
SUPABASE_ANON_KEY=__FILL_ME__
SUPABASE_SERVICE_ROLE_KEY=__FILL_ME__
JWT_SECRET=__FILL_ME__
POSTGRES_PASSWORD=__FILL_ME__

# Optional (can be empty if you don't seed)
APP_SEED_ADMIN_EMAIL=

# SMTP (optional; leave empty if not used)
SMTP_CONFIRMATION_PATH=/auth/confirm
SMTP_INVITE_PATH=/auth/confirm
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=AITuber Kit
SMTP_MAX_FREQUENCY=1s

# Supabase Realtime (required; choose a strong random secret)
REALTIME_SECRET_KEY_BASE=__FILL_ME_STRONG_RANDOM__

