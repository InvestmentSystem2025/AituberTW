# Copy to `.env` on the staging VM (do not commit).
#
# Run:
#   docker compose -f docker-compose.gcp.yml up -d --build

# Which config files to mount
CADDYFILE_NAME=Caddyfile.stg
KONG_CONFIG_NAME=kong.gcp.stg.yml

# Domains / public URLs
FRONTEND_ORIGIN=https://stg.ai-interview.tw
NEXT_PUBLIC_SUPABASE_URL=https://supabase-stg.ai-interview.tw
AUTH_REDIRECT_URL=https://stg.ai-interview.tw
SMTP_DEFAULT_REDIRECT_URL=https://stg.ai-interview.tw
SITE_URL=https://supabase-stg.ai-interview.tw

# Staging Basic Auth (Caddy) - generate hash on the VM:
#   caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=stg
BASIC_AUTH_PASS_HASH=__FILL_ME_HASH__

# Supabase / App secrets (fill with real values; keep stg separate from prod)
SUPABASE_ANON_KEY=__FILL_ME__
SUPABASE_SERVICE_ROLE_KEY=__FILL_ME__
JWT_SECRET=__FILL_ME__
POSTGRES_PASSWORD=__FILL_ME__

# Optional (can be empty if you don't seed)
APP_SEED_ADMIN_EMAIL=

# SMTP (optional; leave empty if not used)
SMTP_CONFIRMATION_PATH=/auth/confirm
SMTP_INVITE_PATH=/auth/confirm
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=AITuber Kit
SMTP_MAX_FREQUENCY=1s

# Supabase Realtime (required; choose a strong random secret)
REALTIME_SECRET_KEY_BASE=__FILL_ME_STRONG_RANDOM__

