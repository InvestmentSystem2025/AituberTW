# 開發模式 Dockerfile
FROM node:20-alpine

# 設定工作目錄
WORKDIR /app

# 複製 package.json
COPY package*.json ./

# 安裝所有依賴（包括 devDependencies）
RUN npm install

# 創建上傳和數據目錄
RUN mkdir -p /app/uploads /app/data

# 設定環境變數
ENV NODE_ENV=development
ENV PORT=3001

# 暴露端口
EXPOSE 3001

# 開發模式：使用 tsx 監聽文件變化並自動重啟
CMD ["npm", "run", "dev"]

