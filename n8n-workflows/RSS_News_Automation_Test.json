{
  "name": "RSS News Automation Test",
  "nodes": [
    {
      "parameters": {},
      "id": "1a8c2e4d-7b9f-4a2d-8e1c-3f5a6b7c8d9e",
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "value": 30
            }
          ]
        }
      },
      "id": "2b9d3f5e-8c1a-5b3d-9f2e-4a6b7c8d9e1f",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://app:3000/api/news/fetch?source=all&limit=5"
      },
      "id": "3c1e4f6a-9d2b-6c4e-1a3f-5b7c8d9e1f2a",
      "name": "Fetch News from API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// 處理從我們 API 獲取的新聞數據\nconst newsData = $input.first().json;\n\nif (!newsData || !newsData.newsItems || !Array.isArray(newsData.newsItems)) {\n  return [];\n}\n\nconst processedItems = [];\n\nfor (const newsItem of newsData.newsItems) {\n  // 直接使用從 API 獲取的數據格式\n  processedItems.push({ json: newsItem });\n}\n\nconsole.log(`Processed ${processedItems.length} news items`);\nreturn processedItems;"
      },
      "id": "6f4b7c9d-3a5e-9f7b-4d6c-8e1f2a3b4c5d",
      "name": "Process News Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:3000/api/news/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"newsItems\": $input.all().map(item => item.json), \"collection\": \"news_knowledge\" } }}",
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "id": "7a5c8d1e-4b6f-1a8c-5e7d-9f2a3b4c5d6e",
      "name": "Send to Vector DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8b6d9e2f-5c7a-2b9d-6f8e-1a3b4c5d6e7f",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "message": "✅ Successfully processed {{ $json.count }} news items at {{ new Date().toLocaleString() }}",
        "options": {}
      },
      "id": "9c7e1a3f-6d8b-3c1e-7a9f-2b4c5d6e7f8a",
      "name": "Success Notification",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "message": "❌ Failed to process news items: {{ $json.error || 'Unknown error' }}",
        "options": {}
      },
      "id": "1d8f2b4a-7e9c-4d2f-8b1e-3c5d6e7f8a9b",
      "name": "Error Notification",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 400]
    }
  ],
