        "url": "http://app:3000/api/news/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"newsItems\": $json.newsItems, \"collection\": \"news_knowledge\" } }}",
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "id": "7a5c8d1e-4b6f-1a8c-5e7d-9f2a3b4c5d6e",
