{
  "name": "RSS News Automation",
  "nodes": [
    {
      "parameters": {},
      "id": "1a8c2e4d-7b9f-4a2d-8e1c-3f5a6b7c8d9e",
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "value": 1
            }
          ]
        }
      },
      "id": "2b9d3f5e-8c1a-5b3d-9f2e-4a6b7c8d9e1f",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "https://technews.tw/feed/",
        "options": {
          "itemsToReturn": 6
        }
      },
      "id": "3c1e4f6a-9d2b-6c4e-1a3f-5b7c8d9e1f2a",
      "name": "Taiwan Tech RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "jsCode": "// 限制 Taiwan Tech RSS 為 6 篇新聞\nconst items = $input.all();\nconst limitedItems = items.slice(0, 6);\nreturn limitedItems;"
      },
      "id": "3d1e4f6a-9d2b-6c4e-1a3f-5b7c8d9e1f2b",
      "name": "Limit Taiwan Tech",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "https://www3.nhk.or.jp/rss/news/cat0.xml",
        "options": {
          "itemsToReturn": 6
        }
      },
      "id": "4d2f5a7b-1e3c-7d5f-2b4a-6c8d9e1f2a3b",
      "name": "Japan News RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [680, 400]
    },
    {
      "parameters": {
        "jsCode": "// 限制 Japan News RSS 為 6 篇新聞\nconst items = $input.all();\nconst limitedItems = items.slice(0, 6);\nreturn limitedItems;"
      },
      "id": "4e2f5a7b-1e3c-7d5f-2b4a-6c8d9e1f2a3c",
      "name": "Limit Japan News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "url": "https://news.ltn.com.tw/rss/novelty.xml",
        "options": {
          "itemsToReturn": 6
        }
      },
      "id": "5e3a6b8c-2f4d-8e6a-3c5b-7d9e1f2a3b4c",
      "name": "LTN Novelty RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [680, 600]
    },
    {
      "parameters": {
        "jsCode": "// 限制 LTN Novelty RSS 為 6 篇新聞\nconst items = $input.all();\nconst limitedItems = items.slice(0, 6);\nreturn limitedItems;"
      },
      "id": "5f3a6b8c-2f4d-8e6a-3c5b-7d9e1f2a3b4d",
      "name": "Limit LTN Novelty",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 600]
    },
    {
      "parameters": {
        "jsCode": "// 將 Taiwan Tech 的 6 筆項目打包為單一 ITEM 並格式化\nconst items = $input.all().map(i => (i.json && i.json.json) ? i.json.json : i.json);\nconst newsItems = items.map(item => {\n  const rawContent = item['content:encoded'] || item.content || item.contentSnippet || item.description || item.summary || '';\n  const cleanContent = String(rawContent).replace(/<[^>]*>/g, '').trim();\n  return {\n    id: `news_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n    title: item.title || 'No Title',\n    content: cleanContent,\n    url: item.link || item.guid || '',\n    publishedAt: item.pubDate || item.published || item.isoDate || new Date().toISOString(),\n    source: 'TechNews Taiwan',\n    language: 'zh-TW'\n  };\n});\nreturn [{ json: { newsItems } }];"
      },
      "id": "a1-pack-tech",
      "name": "Pack Taiwan Tech Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "jsCode": "// 將 Japan News 的 6 筆項目打包為單一 ITEM 並格式化\nconst items = $input.all().map(i => (i.json && i.json.json) ? i.json.json : i.json);\nconst newsItems = items.map(item => {\n  const rawContent = item['content:encoded'] || item.content || item.contentSnippet || item.description || item.summary || '';\n  const cleanContent = String(rawContent).replace(/<[^>]*>/g, '').trim();\n  return {\n    id: `news_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n    title: item.title || 'No Title',\n    content: cleanContent,\n    url: item.link || item.guid || '',\n    publishedAt: item.pubDate || item.published || item.isoDate || new Date().toISOString(),\n    source: 'NHK Japan',\n    language: 'ja'\n  };\n});\nreturn [{ json: { newsItems } }];"
      },
      "id": "a2-pack-japan",
      "name": "Pack Japan News Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 400]
    },
    {
      "parameters": {
        "jsCode": "// 將 LTN Novelty 的 6 筆項目打包為單一 ITEM 並格式化\nconst items = $input.all().map(i => (i.json && i.json.json) ? i.json.json : i.json);\nconst newsItems = items.map(item => {\n  const rawContent = item['content:encoded'] || item.content || item.contentSnippet || item.description || item.summary || '';\n  const cleanContent = String(rawContent).replace(/<[^>]*>/g, '').trim();\n  return {\n    id: `news_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n    title: item.title || 'No Title',\n    content: cleanContent,\n    url: item.link || item.guid || '',\n    publishedAt: item.pubDate || item.published || item.isoDate || new Date().toISOString(),\n    source: 'LTN Taiwan',\n    language: 'zh-TW'\n  };\n});\nreturn [{ json: { newsItems } }];"
      },
      "id": "a3-pack-ltn",
      "name": "Pack LTN Novelty Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:3000/api/news/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"newsItems\": $json.newsItems, \"collection\": \"news_knowledge\" } }}",
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "id": "8b6d9e2f-5c7a-2b9d-6f8e-1a3b4c5d6e7f",
      "name": "Send Taiwan Tech to Vector DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1280, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:3000/api/news/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"newsItems\": $json.newsItems, \"collection\": \"news_knowledge\" } }}",
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "id": "9c7e1a3f-6d8b-3c1e-7a9f-2b4c5d6e7f8a",
      "name": "Send Japan News to Vector DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1280, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:3000/api/news/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"newsItems\": $json.newsItems, \"collection\": \"news_knowledge\" } }}",
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "id": "1d8f2b4a-7e9c-4d2f-8b1e-3c5d6e7f8a9b",
      "name": "Send LTN Novelty to Vector DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1280, 600]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "9c7e1a3f-6d8b-3c1e-7a9f-2b4c5d6e7f8a",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 400]
    },
    {
      "parameters": {
        "message": "✅ Successfully processed {{ $json.count }} news items at {{ new Date().toLocaleString() }}"
      },
      "id": "1d8f2b4a-7e9c-4d2f-8b1e-3c5d6e7f8a9b",
      "name": "Success Notification",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "message": "❌ Failed to process news items: {{ $json.error || 'no items ingested' }}"
      },
      "id": "2e9f3a5b-8d1c-4e3f-9c2d-5f6a7b8c9d1e",
      "name": "Error Notification",
