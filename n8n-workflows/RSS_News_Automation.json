      "id": "5e3a6b8c-2f4d-8e6a-3c5b-7d9e1f2a3b4c",
      "name": "Merge RSS Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// 處理和清理RSS新聞數據 - 單一項目版本\nconst allItems = $input.all();\nconst MAX_ITEMS = 6; // 強制限制：最多處理6個新聞項目\n\nconsole.log(`📥 Processing ${allItems.length} RSS items from all sources (limit: ${MAX_ITEMS})...`);\n\n// 限制處理數量，防止過多項目\nconst limitedItems = allItems.slice(0, MAX_ITEMS);\nconsole.log(`📊 Limited to ${limitedItems.length} items for processing`);\n\n// 收集所有新聞到一個陣列中\nconst allNewsItems = [];\nfor (const item of limitedItems) {\n  const rawContent = item.json.content || item.json.contentSnippet || item.json.description || item.json.summary || '';\n  const cleanContent = rawContent.replace(/<[^>]*>/g, '').trim();\n  \n  const newsItem = {\n    id: `news_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n    title: item.json.title || 'No Title',\n    content: cleanContent,\n    url: item.json.link || '',\n    publishedAt: item.json.pubDate || item.json.published || new Date().toISOString(),\n    source: item.json.link?.includes('nhk') || item.json.link?.includes('asahi') ? 'NHK Japan' : \n            item.json.link?.includes('technews') ? 'TechNews Taiwan' : \n            item.json.link?.includes('ltn') ? 'LTN Taiwan' : 'Unknown',\n    language: item.json.link?.includes('nhk') || item.json.link?.includes('asahi') ? 'ja' : 'zh-TW'\n  };\n  \n  if (newsItem.title && newsItem.title !== 'No Title' && \n      (newsItem.content.length > 20 || newsItem.title.length > 10)) {\n    console.log(`✅ ${newsItem.source}: ${newsItem.title.substring(0, 40)}...`);\n    allNewsItems.push(newsItem);\n  } else {\n    console.log(`❌ Filtered: ${newsItem.title} (content: ${newsItem.content.length} chars)`);\n  }\n}\n\nconsole.log(`📊 Final result: ${allNewsItems.length} valid items processed`);\n\n// 返回單一項目包含所有新聞，避免多次觸發下游節點\nif (allNewsItems.length > 0) {\n  console.log(`📤 Returning single item with ${allNewsItems.length} news items`);\n  return { newsItems: allNewsItems };\n} else {\n  console.log('❌ No valid news items found');\n  return {};\n}"
      },
      "id": "6f4b7c9d-3a5e-9f7b-4d6c-8e1f2a3b4c5d",
      "name": "Process News Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
